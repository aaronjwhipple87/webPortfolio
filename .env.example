# Copy to .env.local for local development, and set the same values in Vercel → Project → Settings → Environment Variables.

# Resend API key for the contact form (https://resend.com/api-keys).
RESEND_API_KEY=

# Where contact form messages are delivered. Defaults to the email in src/content/site.ts.
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend; without one, Resend only
# allows onboarding@resend.dev, which can only send to your Resend account's own email.
CONTACT_FROM_EMAIL="Portfolio Contact <contact@aaronjwhipple.com>"

# Canonical site URL used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://aaronjwhipple.com
